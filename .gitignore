# herdr writes runtime state (logs, session data, sockets, plugin lock)
# directly into ~/.config/herdr, since Stow symlinked the whole directory
# as one unit — it didn't exist before the first stow run, so there was
# nothing to fold into at the file level. Only config.toml is real config.
/home/.config/herdr/*
!/home/.config/herdr/config.toml

# Same issue, but for ~/.claude: on a machine where ~/.claude didn't
# already exist before the first stow run (no prior Claude Code use),
# Stow symlinks the whole directory as one unit instead of folding into
# it file-by-file — so every runtime file Claude Code itself writes
# afterward (projects/, sessions/, shell-snapshots/, history.jsonl,
# daemon/, etc) lands inside this repo's working tree as untracked
# files. Only CLAUDE.md and settings.json are real tracked config.
/home/.claude/*
!/home/.claude/CLAUDE.md
!/home/.claude/settings.json

# scripts/13-gnome-settings.sh copies wallpaper.jpg to a content-hashed
# filename in the same directory on every content change (see that
# script's comment for why) - those cache copies are generated, not real
# config. Only wallpaper.jpg itself is tracked.
/home/.local/share/backgrounds/.wallpaper-*.jpg

# Same whole-directory-symlink issue as herdr/.claude above, but for VS
# Code - and one level higher up than expected: on a machine where
# ~/.config/Code doesn't exist at all yet (no prior VS Code launch), the
# *whole* ~/.config/Code gets symlinked as one unit, not just the User/
# subdirectory - because Code/User/settings.json is the only tracked
# file under Code/ at all, so Code/ itself is the topmost directory that
# didn't already exist. That means everything VS Code writes anywhere
# under ~/.config/Code (CachedExtensionVSIXs/, CachedProfilesData/,
# logs/, machineid, as well as User/'s own globalStorage/,
# workspaceStorage/, History/, etc) lands inside this repo's working
# tree as untracked files. Only settings.json is real tracked config.
/home/.config/Code/*
!/home/.config/Code/User/
/home/.config/Code/User/*
!/home/.config/Code/User/settings.json
